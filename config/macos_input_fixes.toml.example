# macOS input fixes for Horizon — configuration example
#
# Copy this file to the game directory and edit:
#
#   ~/Library/Application Support/horizon/config/macos_input_fixes.toml
#
# The launcher's game home is where `options.txt` lives; the mod reads
# `<game home>/config/macos_input_fixes.toml` once, on the first wheel event of
# a session. Restart the game to reload it.
#
# Missing file, unknown keys, malformed values and broken lines are ignored:
# every unreadable setting keeps its default, so a bad config cannot break
# scrolling.

# MC-121772: fold macOS's Shift-moved horizontal wheel delta back into vertical,
# so Shift+wheel scrolls lists and the hotbar keeps its usual direction.
shift_wheel_fold = true

# One legacy wheel event is exactly one notch, whatever macOS acceleration says.
clamp_legacy_wheel = true

# Trackpad / Magic Mouse: GUI points per notch. 0.0 disables the custom precise
# handling entirely and leaves winit's pixel deltas to Horizon.
points_per_notch = 20.0

# Negate both axes everywhere.
reverse_scrolling = false

# Negate the hotbar's vertical axis only.
reverse_hotbar = false

# Swallow the wheel while attack or use is held (hotbar only).
lock_scroll_while_attacking = false

# Let post-release inertia change the hotbar. Needs M4 momentum detection;
# with the current build the helper always reports no momentum, so this is a
# no-op for now.
momentum_hotbar = false

# The Java mod's hotbar merge (vertical += horizontal). Horizon already falls
# back to the horizontal axis when vertical is zero, so this is rarely needed.
merge_horizontal_into_vertical = false
